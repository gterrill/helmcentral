# Server Configuration
PORT=8080
ENVIRONMENT=development
LOG_LEVEL=info

# InfluxDB Configuration
INFLUXDB_URL=http://localhost:8086
INFLUXDB_ORG=helmcentral
INFLUXDB_BUCKET=marine_data
INFLUXDB_TOKEN=your_influxdb_token_here

# SignalK Configuration
SETTINGS_FILE=../settings.yaml
SIGNALK_VESSEL_PATH=/signalk/v1/api/vessels/self

# Vessel State (temporary fallback until SignalK integration is wired)
VESSEL_STATUS=At Anchor

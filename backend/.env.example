# Server Configuration
PORT=8080
ENVIRONMENT=development
LOG_LEVEL=info

# InfluxDB Configuration
INFLUXDB_URL=http://localhost:8086
INFLUXDB_ORG=helmcentral
INFLUXDB_BUCKET=marine_data
INFLUXDB_TOKEN=your_influxdb_token_here

# SignalK Configuration
SETTINGS_FILE=../settings.yaml
SIGNALK_VESSEL_PATH=/signalk/v1/api/vessels/self
SIGNALK_USERNAME=admin
SIGNALK_PASSWORD=your_signalk_password_here
SIGNALK_GPX_TRACKS_DIR=/Main-Storage/data/signalk/gpx-tracks

# Vessel State (temporary fallback until SignalK integration is wired)
VESSEL_STATUS=At Anchor

WEATHERKIT_KEY_ID="YOUR_KEY_ID"
WEATHERKIT_TEAM_ID="YOUR_TEAM_ID"
WEATHERKIT_SERVICE_ID="YOUR_SERVICE_ID"
WEATHERKIT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
MIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQg...
...
-----END PRIVATE KEY-----"

# Storm Glass Configuration (for tide predictions)
STORMGLASS_API_KEY="your_stormglass_api_key_here"

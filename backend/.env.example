# Server Configuration
PORT=8080
ENVIRONMENT=development
LOG_LEVEL=info

# SignalK Configuration
SETTINGS_FILE=../settings.yaml
SIGNALK_VESSEL_PATH=/signalk/v1/api/vessels/self

# Vessel State (temporary fallback until SignalK integration is wired)
VESSEL_STATUS=At Anchor

# Secrets (SIGNALK_USERNAME/PASSWORD, INFLUXDB_TOKEN, STORMGLASS_API_KEY,
# GEONAMES_USERNAME, WEATHERKIT_*) are no longer set via env vars/.env -
# they're managed at runtime through the Settings UI's Secrets panel and
# stored encrypted at rest (see docs/adr/0023-encrypted-secrets-store.md).
# HELMCENTRAL_MASTER_KEY is an optional override for the encryption key that
# is otherwise auto-generated on first run.

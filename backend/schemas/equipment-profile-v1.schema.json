{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://helmcentral.local/schemas/equipment-profile-v1.schema.json",
  "title": "Equipment Profile v1",
  "oneOf": [
    { "$ref": "#/definitions/engineProfile" },
    { "$ref": "#/definitions/alternatorProfile" },
    { "$ref": "#/definitions/generatorProfile" },
    { "$ref": "#/definitions/batteryProfile" }
  ],
  "definitions": {
    "baseProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "kind", "id", "name"],
      "properties": {
        "schema_version": { "type": "integer", "const": 1 },
        "kind": { "type": "string", "enum": ["engine", "alternator", "generator"] },
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "manufacturer": { "type": "string" },
        "model": { "type": "string" },
        "rating_hp": { "type": "integer", "minimum": 0 },
        "source": { "type": "string" },
        "notes": { "type": "string" },
        "gauges": {
          "type": "array",
          "items": { "$ref": "#/definitions/gauge" }
        },
        "service": {
          "type": "array",
          "items": { "$ref": "#/definitions/service" }
        }
      },
      "anyOf": [
        { "required": ["gauges"] },
        { "required": ["service"] }
      ]
    },
    "engineProfile": {
      "allOf": [
        { "$ref": "#/definitions/baseProfile" },
        {
          "properties": {
            "kind": { "const": "engine" },
            "gauges": {
              "type": "array",
              "items": {
                "allOf": [
                  { "$ref": "#/definitions/gauge" },
                  {
                    "required": ["path_suffix"]
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "alternatorProfile": {
      "allOf": [
        { "$ref": "#/definitions/baseProfile" },
        {
          "properties": {
            "kind": { "const": "alternator" },
            "gauges": {
              "type": "array",
              "items": {
                "allOf": [
                  { "$ref": "#/definitions/gauge" },
                  {
                    "required": ["path_suffix"]
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "generatorProfile": {
      "allOf": [
        { "$ref": "#/definitions/baseProfile" },
        {
          "properties": {
            "kind": { "const": "generator" },
            "gauges": {
              "type": "array",
              "items": {
                "allOf": [
                  { "$ref": "#/definitions/gauge" },
                  {
                    "required": ["path_suffix"]
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "batteryProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "kind", "id", "name", "chemistry"],
      "properties": {
        "schema_version": { "type": "integer", "const": 1 },
        "kind": { "const": "battery" },
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "manufacturer": { "type": "string" },
        "model": { "type": "string" },
        "source": { "type": "string" },
        "notes": { "type": "string" },
        "chemistry": { "type": "string", "minLength": 1 },
        "full_soc": { "$ref": "#/definitions/batteryThreshold" },
        "charge_warn": { "$ref": "#/definitions/batteryThreshold" },
        "charge_high": { "$ref": "#/definitions/batteryThreshold" }
      }
    },
    "batteryThreshold": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": { "type": ["number", "null"] },
        "source": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "zone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direction", "state"],
      "properties": {
        "direction": { "type": "string", "enum": ["below", "above"] },
        "threshold": { "type": ["number", "null"] },
        "state": { "type": "string", "enum": ["normal", "warn", "alarm"] },
        "source": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "gauge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path_suffix", "label", "display", "quantity", "unit"],
      "properties": {
        "path_suffix": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "hero": { "type": "boolean" },
        "display": { "type": "string", "enum": ["numeric", "radial", "bar", "lamp", "trend"] },
        "quantity": { "type": "string", "minLength": 1 },
        "unit": { "type": "string", "minLength": 1 },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "decimals": { "type": "integer" },
        "zones": {
          "type": "array",
          "items": { "$ref": "#/definitions/zone" }
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "interval_hours": { "type": ["number", "null"] },
        "interval_months": { "type": ["integer", "null"] },
        "first_at_hours": { "type": ["number", "null"] },
        "supersedes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "source": { "type": ["string", "null"] }
      }
    }
  }
}

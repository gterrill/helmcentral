# Allow the embed placeholder while ignoring real build output. backend/dist is
# where the built frontend is staged for //go:embed (by the Dockerfile and the
# GoReleaser hooks), so its contents must never be committed — but .gitkeep has
# to stay tracked or `go build` fails on a fresh clone.
!backend/dist/
backend/dist/*
!backend/dist/.gitkeep
settings.yaml
.claude/settings.json
/backend-data/
/plugins/
# Scratch notes kept across branches, not part of any change
/temp.md

# Plugin binaries built in place by the TinyGo build documented in each
# plugin's README; the deployed copies live in the ignored /plugins/.
# (backend/testdata/**/*.wasm are committed test fixtures and stay tracked.)
/docs/examples/**/*.wasm

.DS_Store
*.log
node_modules/
dist/
build/
# GoReleaser output
/dist-plugins/
.vscode/settings.json
backend/cache/
backend/tmp/
backend/helmcentral
backend/data/routes.json
backend/data/dashboard-layout.json
backend/data/dashboard-pages.json
# Removed feature (ADR 0113), but an instance that took an upload
# before the removal still has the files on disk. Keep ignoring them
# so a stray `git add -A` can't stage multi-GiB MBTiles.
backend/data/sat-charts/
backend/data/tile-cache.sqlite
backend/data/nearby-contacts.sqlite
backend/data/secrets.sqlite
backend/data/secrets.key
backend/data/sessions.sqlite
backend/data/plugin_overrides.sqlite
backend/data/alarm-rules.json
backend/data/alarm-log.sqlite
backend/data/assistant.sqlite
backend/data/documents.sqlite
backend/data/webpush-subscriptions.sqlite
backend/data/alarm-transports.json
# WAL mode (tile-cache.sqlite, and nearby-contacts.sqlite as of the backend
# perf audit) leaves a -wal and -shm file next to the main one between
# checkpoints; cover every sqlite file in backend/data with one pattern pair
# rather than listing each store's WAL siblings individually above.
backend/data/*.sqlite-wal
backend/data/*.sqlite-shm
# Allow the embed placeholder while ignoring real build output. backend/dist is
# where the built frontend is staged for //go:embed (by the Dockerfile and the
# GoReleaser hooks), so its contents must never be committed — but .gitkeep has
# to stay tracked or `go build` fails on a fresh clone.
!backend/dist/
backend/dist/*
!backend/dist/.gitkeep
# Same reasoning as backend/dist above, for the operator manual staged into
# backend/manual for //go:embed (the Makefile's manual-stage target, the
# Dockerfile and the GoReleaser hooks copy docs/features, docs/how-to and
# docs/reference there) - the docs tree is the source of truth, not this copy.
!backend/manual/
backend/manual/*
!backend/manual/.gitkeep
settings.yaml
.claude/settings.json
/backend-data/
# Built plugin binaries are deployed here, not authored here — the .wasm
# sources live in docs/examples/*-plugins/. Engine profiles (ADR 0053) are the
# exception: hand-authored JSON with no build step, so they are tracked.
/plugins/*
!/plugins/engine-profiles/
# Scratch notes kept across branches, not part of any change
/temp.md

# Plugin binaries built in place by the TinyGo build documented in each
# plugin's README; the deployed copies live in the ignored /plugins/.
# (backend/testdata/**/*.wasm are committed test fixtures and stay tracked.)
/docs/examples/**/*.wasm

# Local docker compose overrides (CORS_ALLOWED_ORIGINS and the like); never committed.
.env

# TypeScript incremental build state
*.tsbuildinfo
frontend/vite.config.js
frontend/vite.config.d.ts

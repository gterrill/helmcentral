[Unit]
Description=Helmcentral marine dashboard
Documentation=https://github.com/gterrill/helmcentral
# SignalK is the one hard dependency. Wants= rather than Requires= so
# Helmcentral still starts (and can run its discovery sweep) when SignalK
# lives on a different machine and there is no local unit to order against.
Wants=network-online.target
After=network-online.target signalk.service

# Startup is deliberately fail-fast: an unreadable secrets store, plugin
# override store, tile cache or helmcentral.sqlite (documents, Mate's
# conversations, the AIS sighting log) calls log.Fatalf rather than
# degrading - as does finding a pre-upgrade documents.sqlite/
# assistant.sqlite/nearby-contacts.sqlite/alarm-log.sqlite/
# webpush-subscriptions.sqlite/plugin_overrides.sqlite still sitting in the
# data directory, which needs the one-time `helmcentral migrate-db` command
# run first. Cap restarts so a genuinely broken state dir surfaces as a
# failed unit instead of an endless loop. StartLimitIntervalSec= is read only
# in [Unit]; in [Service] systemd ignores it. StartLimitBurst= (and the legacy
# StartLimitInterval=) still work in [Service] for compatibility, so the old
# unit ran with a burst of 5 over the default 10 s interval, which restarts
# 5 s apart never reached. A SignalK that is slow to start does not use up the
# cap: Helmcentral waits for it inside one start. Some boot faults take minutes
# to clear, such as the data disk mounting late after a power cut, so the cap
# is loose: 135 starts 5 s apart is about 11 minutes of retries. The unit is
# left failed only when 135 starts land inside the 20 minute window, which
# holds while each start fails within about 3.9 s. A start that runs longer
# than that before failing spaces the cycles out, the window forgets the early
# ones and the unit keeps retrying.
StartLimitIntervalSec=1200
StartLimitBurst=135

[Service]
Type=simple
User=helmcentral
Group=helmcentral

WorkingDirectory=/var/lib/helmcentral

# Every piece of runtime state — the SQLite stores, routes, dashboard
# pages, plugin caches and the reference plugins — resolves
# through cacheFilePath() in backend/weather_tide.go, which roots relative
# paths at HELMCENTRAL_STATE_DIR. Without this the binary would scatter state
# through its working directory.
Environment=HELMCENTRAL_STATE_DIR=/var/lib/helmcentral
# settings.yaml is read *and rewritten* by POST /api/settings from the
# Settings UI, so it belongs in the writable state dir, not /etc.
Environment=SETTINGS_FILE=/var/lib/helmcentral/settings.yaml
Environment=PORT=8080

ExecStart=/usr/local/bin/helmcentral

Restart=on-failure
RestartSec=5s

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/helmcentral
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target

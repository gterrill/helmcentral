{
  "compilerOptions": {
    "composite": true,
    // Emit (required by composite) goes under node_modules, never beside
    // vite.config.ts: Vite loads a vite.config.js ahead of the .ts one.
    "outDir": "./node_modules/.tmp/tsconfig.node",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node/tsbuildinfo",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true
  },
  "include": ["vite.config.ts"]
}
